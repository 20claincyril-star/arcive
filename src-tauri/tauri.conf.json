{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Arcive",
  "version": "1.0.1",
  "identifier": "com.arcive.desktop",
  "build": {
    "frontendDist": "../dist-frontend",
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Arcive",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}